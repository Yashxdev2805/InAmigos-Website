# ==========================================
# InAmigos Foundation - Root Workspace .gitignore
# Security Audit & Secrets Exclusion Policy
# ==========================================

# 1. Environment & API Secrets
.env
.env.local
.env.*
*.env

# 2. Service Account Keys & Certificates
*.json.key
service_account*.json
*.pem
*.key
*.crt

# 3. Dependencies & Build Artifacts
node_modules/
.next/
dist/
build/
out/

# 4. Extra, Uploads & Temporary Scratch Folders
extra/
scratch/
temp/
tmp/
uploads/
uploads_backup/
private/
coverage/

# 5. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*

# 6. IDE & OS Junk
.vscode/
.idea/
.gemini/
.DS_Store
Thumbs.db
Desktop.ini
