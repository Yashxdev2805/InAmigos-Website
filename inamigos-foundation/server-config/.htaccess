# ==============================================================================
# InAmigos Foundation - Production Apache Hardening & Security Configuration
# Phase 1 Remediation: Security Headers, Malicious File Blocking, HSTS, CSP
# ==============================================================================

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS Redirect
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} ^inamigosfoundation\.org\.in$ [OR]
    RewriteCond %{HTTP_HOST} ^www\.inamigosfoundation\.org\.in$
    RewriteRule ^(.*)$ https://inamigosfoundation.org.in/$1 [R=301,L]

    # Fix /blog/blog/ redirect leak issue (OWASP ZAP Finding: Big Redirect Body Leak)
    RewriteRule ^blog/blog/?$ /blog [R=301,L]
</IfModule>

# Suppress Server Fingerprints (OWASP ZAP Finding: Server Leaks Info via X-Powered-By)
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header unset Server
    Header always unset X-Powered-By

    # Enforce Military-Grade HTTP Security Headers
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set X-XSS-Protection "1; mode=block"

    # Content Security Policy (Fallback Level 3)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' blob: data: https://images.unsplash.com; connect-src 'self' https://api.stripe.com https://api.razorpay.com; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests;"
</IfModule>

# Disable Directory Browsing
Options -Indexes

# Block Access to Sensitive System & Secret Files
<FilesMatch "^\.env|\.git|\.htaccess|composer\.json|package\.json|package-lock\.json|tsconfig\.json|\.sh|\.sql$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block Known Malicious PHP Execution in Upload Directories
<Directory "/public/uploads">
    <FilesMatch "\.(php|php5|phtml|php7|phps)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</Directory>
