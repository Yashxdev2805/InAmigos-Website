# ==========================================
# InAmigos Foundation - Frontend .gitignore
# Security Audit & Secrets Exclusion Policy
# ==========================================

# 1. Environment & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env

# 2. Private Keys & Certificates
*.pem
*.key
*.crt
*.pfx
*.p12

# 3. Dependencies & Package Managers
/node_modules
/.pnp
.pnp.js
.yarn/sdks
.yarn/unplugged

# 4. Next.js & Vercel Build Outputs
/.next/
/out/
/build
/dist
.vercel
.turbo/

# 5. Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# 6. Extra, Uploads & Temporary Scratch Folders
extra/
scratch/
temp/
tmp/
uploads/
uploads_backup/
private/
coverage/

# 7. IDE & System OS Junk
.vscode/
.idea/
.gemini/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
